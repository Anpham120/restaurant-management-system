@startuml
!include _style.iuml
skinparam style strictuml
hide empty members
title Biểu đồ lớp thanh toán (module finance, mẫu Strategy)
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55
skinparam defaultFontSize 14
skinparam package {
  BorderColor #475569
  FontStyle bold
  FontSize 15
}

package "controller" #F1F5F9 {
  class PaymentController <<RestController>> {
    + startPayment(invoiceId, request) : ApiResponse<PaymentResponse>
  }
  class SepayWebhookController <<RestController>> {
    + receive(authorization, rawBody) : ApiResponse<WebhookResult>
  }
}
package "service" #EFF6FF {
  interface PaymentService <<interface>> {
    + startPayment(invoiceId, actorId, request) : PaymentResponse
  }
  class PaymentServiceImpl {
    - strategies : Map<PaymentMethod, PaymentStrategy>
    + startPayment(invoiceId, actorId, request) : PaymentResponse
  }
  class SepayWebhookService {
    + receiveTransferWebhook(authorization, rawBody)
  }
  class QrTransferProcessor
  class InvoiceSettlement {
    + settlePaidInvoice(invoice, actorId)
  }
}
package "strategy" #FFFBEB {
  interface PaymentStrategy <<interface>> <<Strategy>> {
    + method() : PaymentMethod
    + startPayment(invoiceId, actorId, request) : PaymentResponse
  }
  class CashPaymentStrategy
  class QrPaymentStrategy
  enum PaymentMethod <<enumeration>> {
    CASH
    QR
  }
}
package "repository" #F0FDF4 {
  interface PaymentRequestRepository <<interface>>
  interface PaymentRepository <<interface>>
}
package "module order" #FEF2F2 {
  interface OrderBillingApi <<interface>> <<API module>> {
    + closeOrderAndReleaseTable(orderId, actorId)
  }
}

PaymentController --> PaymentService
PaymentService <|.. PaymentServiceImpl
PaymentServiceImpl o--> "1..*" PaymentStrategy
PaymentStrategy <|.. CashPaymentStrategy
PaymentStrategy <|.. QrPaymentStrategy
PaymentStrategy --> PaymentMethod
SepayWebhookController --> SepayWebhookService
SepayWebhookService --> QrTransferProcessor
CashPaymentStrategy ..> InvoiceSettlement
QrTransferProcessor ..> InvoiceSettlement
CashPaymentStrategy ..> PaymentRequestRepository
CashPaymentStrategy ..> PaymentRepository
QrPaymentStrategy ..> PaymentRequestRepository
QrTransferProcessor ..> PaymentRepository
InvoiceSettlement .[#EA580C].> OrderBillingApi

legend bottom
  Thêm phương thức thanh toán mới = thêm một lớp cài PaymentStrategy; Spring tiêm vào Map, không sửa PaymentServiceImpl.
  Hai đường thu tiền (tiền mặt, webhook SePay) đều kết thúc ở InvoiceSettlement.
endlegend
@enduml
