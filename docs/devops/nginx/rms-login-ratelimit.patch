--- a/rms.atlasplatform12.tech.conf
+++ b/rms.atlasplatform12.tech.conf
@@ -4,6 +4,18 @@
 
     client_max_body_size 1m;
 
+    # Chống dò mật khẩu theo IP (zone rms_login: docs/devops/nginx/rms-login-ratelimit.conf); vượt giới hạn trả 429
+    location = /api/auth/login {
+        limit_req zone=rms_login burst=5 nodelay;
+        limit_req_status 429;
+        proxy_pass http://127.0.0.1:8081;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_read_timeout 30s;
+    }
+
     location /api/ {
         proxy_pass http://127.0.0.1:8081;
         proxy_set_header Host $host;
