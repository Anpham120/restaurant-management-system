@startuml
!include ../_style.puml
title Sơ đồ hoạt động – Kiểm kê và điều chỉnh hao hụt

|Manager|
start
:Tạo phiếu kiểm kê (DRAFT);
repeat
  :Chọn nguyên liệu / lô cần kiểm;
  |Hệ thống|
  :Hiển thị tồn sổ sách của lô;
  |Manager|
  :Nhập số lượng thực tế;
  |Hệ thống|
  :Chênh lệch = thực tế − sổ sách;
  if (Chênh lệch ≠ 0?) then (có)
    |Manager|
    :Nhập lý do (bắt buộc);
  else (không)
  endif
  |Manager|
repeat while (Kiểm lô khác?) is (có) not (không)
:Xác nhận kiểm kê;
|Hệ thống|
if (Phiếu còn DRAFT và tồn sổ sách\ncác lô chưa đổi từ lúc kiểm?) then (có)
  :Đặt tồn lô bằng số thực tế, ghi biến động\nADJUSTMENT cho dòng có chênh lệch;
  :Phiếu CONFIRMED, lưu người\nvà thời điểm xác nhận;
  if (Tồn sử dụng được < đặt giữ\nđang hoạt động?) then (có)
    :Cảnh báo thiếu nguyên liệu đã đặt giữ;
    :Ngừng nhận thêm món bị ảnh hưởng,\nthông báo POS xử lý món đã chấp nhận;
    note right: Không tự hủy đơn,\nkhông tự xóa đặt giữ
  else (không)
  endif
  :Tính lại khả dụng, đồng bộ POS / Mobile;
else (không)
  :Từ chối, nêu các lô cần kiểm lại;
endif
|Manager|
:Xem kết quả kiểm kê;
stop
@enduml
