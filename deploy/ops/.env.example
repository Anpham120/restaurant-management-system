# Copy to ~/monitoring/.env on the monitoring server and fill in (docs-core/11 section 11.10).
# Name of this server; a DNS A record must point to it before the first start (Caddy gets the certificate).
MONITOR_DOMAIN=monitor.khoibep.example.vn
# What blackbox exporter calls from here, as a customer would (SiteDown alert)
SITE_URL_PRODUCTION=https://khoibep.example.vn/actuator/health
SITE_URL_STAGING=https://staging.khoibep.example.vn/actuator/health
# Grafana sign-in: user admin, this password
GRAFANA_ADMIN_PASSWORD=change-me
# From @BotFather, and the id of the group that gets the alerts (a negative number)
TELEGRAM_BOT_TOKEN=123456789:change-me
TELEGRAM_CHAT_ID=-1001234567890
# The account the agent of the application server pushes with. The hash comes from:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# Keep the single quotes: the hash has $ signs in it.
INGEST_USER=agent
INGEST_PASSWORD_HASH='$2a$14$change.me.with.the.output.of.caddy.hash-password'

# ---- P0-08: Jenkins (docs-core/11 section 11.11) ----
# Name of Jenkins on this server; a DNS A record must point here too.
JENKINS_DOMAIN=jenkins.khoibep.example.vn
# Jenkins sign-in: user admin, this password
JENKINS_ADMIN_PASSWORD=change-me
# A GitHub account with push access and its classic token with the scopes repo:status and write:packages
GITHUB_USER=change-me
GITHUB_TOKEN=change-me
# Owner of the images on GHCR, lowercase (same as GHCR_OWNER on the application server)
GHCR_OWNER=anpham120
# Address of the application server, where the deploy user takes the deploys over SSH
APP_SERVER_HOST=203.0.113.10
# Group of /var/run/docker.sock on this server: getent group docker | cut -d: -f3
DOCKER_GID=999
