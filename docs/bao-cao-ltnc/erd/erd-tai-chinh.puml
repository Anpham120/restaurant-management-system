@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam entity {
  BackgroundColor #EAF2FB
  BorderColor #1565C0
}
title ERD phân hệ Tài chính
entity "operating_expenses" as operating_expenses {
  * id : bigint <<PK>>
  --
  * business_date : date
  * category : character varying(30)
  * description : character varying(255)
  * amount : numeric(12,2)
  * payment_method : character varying(20)
  * fund_source : character varying(20)
  stock_receipt_id : bigint <<FK>>
  * recorded_by_id : bigint <<FK>>
  * paid_at : timestamp with time zone
  * request_key : character varying(64)
  * status : character varying(20)
  void_reason : character varying(255)
  voided_by_id : bigint <<FK>>
  voided_at : timestamp with time zone
  request_hash : character(64)
}
entity "daily_cash_reconciliations" as daily_cash_reconciliations {
  * id : bigint <<PK>>
  --
  * business_date : date
  * status : character varying(20)
  * opening_cash : numeric(12,2)
  * cash_sales : numeric(12,2)
  * cash_expenses : numeric(12,2)
  expected_cash : numeric(12,2)
  * actual_cash : numeric(12,2)
  difference : numeric(12,2)
  reason : character varying(255)
  revision_reason : character varying(255)
  * reconciled_by_id : bigint <<FK>>
  * reconciled_at : timestamp with time zone
}
entity "employees" as employees #F3F6FA {
  * id : bigint <<PK>>
}
entity "stock_receipts" as stock_receipts #F3F6FA {
  * id : bigint <<PK>>
}
daily_cash_reconciliations }o--|| employees : reconciled_by_id
operating_expenses }o--|| employees : recorded_by_id
operating_expenses }o--o| stock_receipts : stock_receipt_id
operating_expenses }o--o| employees : voided_by_id
@enduml
