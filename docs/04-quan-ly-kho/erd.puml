@startuml
!include ../_style.puml
hide circle
set separator none
skinparam linetype ortho
skinparam nodesep 85
skinparam ranksep 55
title ERD – Phân hệ 4: Quản lý kho & nguyên liệu

entity "ingredients" as ingredients {
  * id : bigint <<PK>>
  --
  * name : varchar(100) <<UK>>
  * base_unit : varchar(20)
  * min_quantity : decimal(12,3)
  * is_expiry_tracked : boolean
  * is_active : boolean
  ..
  CHECK min_quantity >= 0
}

entity "recipes" as recipes #line.dashed {
  * id : bigint <<PK>>
  --
  * version : int
}

entity "recipe_ingredients" as recipe_ingredients #line.dashed {
  * id : bigint <<PK>>
  --
  * recipe_id : bigint <<FK>>
  * ingredient_id : bigint <<FK>>
  * quantity_per_serving : decimal(12,3)
}

entity "daily_menu_items" as daily_menu_items #line.dashed {
  * id : bigint <<PK>>
  --
  * recipe_id : bigint <<FK>>
}

entity "order_items" as order_items #line.dashed {
  * id : bigint <<PK>>
  --
  * daily_menu_item_id : bigint <<FK>>
  * quantity : int
  * status : varchar(20)
  * has_stock_exception : boolean
}

entity "employees" as employees #line.dashed {
  * id : bigint <<PK>>
  --
  * employee_code : varchar(20) <<UK>>
  * full_name : varchar(100)
}

entity "stock_receipts" as stock_receipts {
  * id : bigint <<PK>>
  --
  supplier_name : varchar(100)
  * status : varchar(20)
  note : varchar(255)
  * created_at : timestamptz
  confirmed_by_id : bigint <<FK>>
  confirmed_at : timestamptz
  ..
  CHECK status IN (DRAFT, CONFIRMED)
  CHECK CONFIRMED: bắt buộc confirmed_by_id, confirmed_at
}

entity "stock_receipt_items" as stock_receipt_items {
  * id : bigint <<PK>>
  --
  * stock_receipt_id : bigint <<FK>>
  * ingredient_id : bigint <<FK>>
  * input_quantity : decimal(12,3)
  * input_unit : varchar(20)
  * conversion_factor : decimal(12,3)
  * quantity : decimal(12,3)
  * unit_price : decimal(12,2)
  lot_code : varchar(50)
  expiry_date : date
  ..
  UK (id, ingredient_id)
  UK (stock_receipt_id, ingredient_id, lot_code, expiry_date) NULLS NOT DISTINCT
  CHECK input_quantity > 0 AND conversion_factor > 0
  CHECK unit_price >= 0
  CHECK quantity = ROUND(input_quantity * conversion_factor, 3)
}

entity "inventory_batches" as inventory_batches {
  * id : bigint <<PK>>
  --
  * ingredient_id : bigint <<FK>>
  * stock_receipt_item_id : bigint <<FK, UK>>
  lot_code : varchar(50)
  expiry_date : date
  * received_at : timestamptz
  * quantity_on_hand : decimal(12,3)
  * reserved_quantity : decimal(12,3)
  * is_usable : boolean
  unusable_reason : varchar(255)
  unusable_marked_by_id : bigint <<FK>>
  unusable_marked_at : timestamptz
  ..
  FK (stock_receipt_item_id, ingredient_id) → stock_receipt_items (id, ingredient_id)
  CHECK quantity_on_hand >= 0
  CHECK reserved_quantity >= 0
  CHECK NOT is_usable: bắt buộc unusable_reason
}

entity "stock_reservations" as stock_reservations {
  * id : bigint <<PK>>
  --
  * order_item_id : bigint <<FK>>
  * inventory_batch_id : bigint <<FK>>
  * quantity : decimal(12,3)
  * status : varchar(20)
  release_reason : varchar(30)
  * created_at : timestamptz
  closed_at : timestamptz
  ..
  PARTIAL UK (order_item_id, inventory_batch_id) WHERE status = ACTIVE
  CHECK status IN (ACTIVE, CONSUMED, RELEASED)
  CHECK release_reason IN (ITEM_CANCELLED, ITEM_EDITED, LOT_UNAVAILABLE)
  CHECK quantity > 0
  CHECK RELEASED: bắt buộc release_reason
  CHECK CONSUMED, RELEASED: bắt buộc closed_at
}

entity "stock_movements" as stock_movements {
  * id : bigint <<PK>>
  --
  * inventory_batch_id : bigint <<FK>>
  * movement_type : varchar(20)
  * quantity_delta : decimal(12,3)
  * balance_after : decimal(12,3)
  order_item_id : bigint <<FK>>
  stock_count_item_id : bigint <<FK, UK>>
  * created_at : timestamptz
  ..
  PARTIAL UK (inventory_batch_id) WHERE movement_type = RECEIPT
  PARTIAL UK (order_item_id, inventory_batch_id) WHERE movement_type = CONSUMPTION
  CHECK movement_type IN (RECEIPT, CONSUMPTION, ADJUSTMENT)
  CHECK quantity_delta <> 0
  CHECK balance_after >= 0
  CHECK nguồn khớp movement_type
}

entity "stock_counts" as stock_counts {
  * id : bigint <<PK>>
  --
  * status : varchar(20)
  note : varchar(255)
  * created_at : timestamptz
  confirmed_by_id : bigint <<FK>>
  confirmed_at : timestamptz
  ..
  CHECK status IN (DRAFT, CONFIRMED)
  CHECK CONFIRMED: bắt buộc confirmed_by_id, confirmed_at
}

entity "stock_count_items" as stock_count_items {
  * id : bigint <<PK>>
  --
  * stock_count_id : bigint <<FK>>
  * inventory_batch_id : bigint <<FK>>
  * book_quantity : decimal(12,3)
  * actual_quantity : decimal(12,3)
  * difference : decimal(12,3)
  reason : varchar(255)
  ..
  UK (stock_count_id, inventory_batch_id)
  CHECK actual_quantity >= 0
  CHECK difference = actual_quantity - book_quantity
  CHECK difference <> 0: bắt buộc reason
}

employees |o--o{ stock_receipts : confirmed_by
employees |o--o{ stock_counts : confirmed_by
employees |o--o{ inventory_batches : marked_unusable_by
recipes ||--o{ recipe_ingredients : contains
recipes ||--o{ daily_menu_items : applied_to
daily_menu_items ||--o{ order_items : selected_from
ingredients ||--o{ recipe_ingredients : used_in
ingredients ||--o{ stock_receipt_items : received_as
ingredients ||--o{ inventory_batches : stored_in
stock_receipts ||--o{ stock_receipt_items : contains
stock_receipt_items ||--o| inventory_batches : creates
inventory_batches ||--o{ stock_movements : affected_by
inventory_batches ||--o{ stock_reservations : reserved_from
order_items ||--o{ stock_reservations : reserves
order_items |o--o{ stock_movements : consumed_by
stock_counts ||--o{ stock_count_items : contains
inventory_batches ||--o{ stock_count_items : counted_in
stock_count_items |o--o| stock_movements : adjusted_by
@enduml
