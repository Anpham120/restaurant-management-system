// Phân hệ Nhân sự: nhân viên, tài khoản, phân quyền: 8 bảng. Sinh tự động từ catalog PostgreSQL (gen_dbml.py).
// Dán toàn bộ file vào https://dbdiagram.io/d để xem database diagram.

Project atlas_restaurant {
  database_type: 'PostgreSQL'
}

Table departments {
  id bigint [pk]
  department_name varchar(50) [not null]
}

Table employees {
  id bigint [pk]
  employee_code varchar(20) [not null]
  full_name varchar(100) [not null]
  gender varchar(10)
  date_of_birth date
  phone varchar(15)
  email varchar(100)
  address varchar(255)
  hire_date date
  end_date date
  work_status varchar(20) [not null]
  department_id bigint [not null]
}

Table accounts {
  id bigint [pk]
  employee_id bigint [not null, unique]
  username varchar(50) [not null]
  password_hash varchar(255) [not null]
  must_change_password boolean [not null]
  account_status varchar(20) [not null]
  token_version int [not null]
}

Table roles {
  id bigint [pk]
  role_code varchar(30) [not null]
  role_name varchar(50) [not null]
}

Table account_roles {
  id bigint [pk]
  account_id bigint [not null]
  role_id bigint [not null]
}

Table permissions {
  id bigint [pk]
  permission_code varchar(50) [not null]
  description varchar(255) [not null]
}

Table role_permissions {
  id bigint [pk]
  role_id bigint [not null]
  permission_id bigint [not null]
}

Table login_throttles {
  username_key varchar(50) [pk]
  failures int [not null]
  first_failure_at timestamptz [not null]
  locked_until timestamptz
}

Ref: employees.department_id > departments.id
Ref: accounts.employee_id - employees.id
Ref: account_roles.account_id > accounts.id
Ref: account_roles.role_id > roles.id
Ref: role_permissions.permission_id > permissions.id
Ref: role_permissions.role_id > roles.id

TableGroup "Nhân sự: nhân viên, tài khoản, phân quyền" {
  departments
  employees
  accounts
  roles
  account_roles
  permissions
  role_permissions
  login_throttles
}
