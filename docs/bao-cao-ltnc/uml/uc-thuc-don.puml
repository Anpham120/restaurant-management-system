@startuml
!include _style.iuml
title Use case chi tiết: thực đơn
left to right direction
actor "Quản lý" as M
actor "Bếp" as K
actor "Phục vụ" as W
rectangle "Thực đơn" {
  usecase "Quản lý nhóm món" as T1
  usecase "Quản lý món, giá bán" as T2
  usecase "Khai báo công thức (phiên bản)" as T3
  usecase "Lập thực đơn ngày" as T4
  usecase "Đặt hạn mức suất" as T5
  usecase "Công bố / đóng thực đơn" as T6
  usecase "Tạm dừng / mở lại món" as T7
  usecase "Xem thực đơn hôm nay" as T8
}
M --> T1
M --> T2
M --> T3
M --> T4
M --> T6
T4 <.. T5 : <<extend>>
K --> T7
M --> T7
W --> T8
K --> T8
@enduml
