@startuml
!include _style.iuml
skinparam style strictuml
hide empty members
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 55
skinparam defaultFontSize 14
skinparam package {
  BorderColor #475569
  FontStyle bold
  FontSize 15
}
title Biểu đồ lớp kiến trúc: giao tiếp giữa các module nghiệp vụ

package "finance" as finance #FEF2F2 {
  class InvoiceServiceImpl
  class OrderInvoiceAccessImpl
}

package "order" as order #EFF6FF {
  interface OrderBillingApi <<interface>> <<API module>> {
    + lockOrderForBilling(orderId)
    + getServedItems(orderId)
    + closeOrderAndReleaseTable(orderId, actorId)
  }
  interface OrderInvoiceAccess <<interface>> <<khai báo, finance cài>> {
    + findInvoiceStatus(orderId)
    + reopenInvoiceForMoreOrdering(orderId)
  }
  class OrderBillingApiImpl
  class OrderServiceImpl
  class OrderItemStockFlagsImpl
  class QuotaUsageCounterImpl
}

package "inventory" as inventory #F0FDF4 {
  interface KitchenStockAllocator <<interface>> <<API module>> {
    + reserveIngredientsForItem(...)
    + consumeReservationsForCooking(orderItemId)
  }
  interface OrderItemStockFlags <<interface>> <<khai báo, order cài>> {
    + markStockException(orderItemIds)
  }
  class KitchenStockAllocatorImpl
}

package "menu" as menu #FFFBEB {
  interface DailyMenuLookup <<interface>> <<API module>> {
    + findOrderableDish(dailyMenuItemId)
    + getRecipeLines(dailyMenuItemId)
  }
  interface QuotaUsageCounter <<interface>> <<khai báo, order cài>> {
    + countUsedPortions(dailyMenuItemId)
  }
  class DailyMenuLookupImpl
}

' Xếp các module thẳng hàng từ trên xuống theo chiều phụ thuộc
InvoiceServiceImpl -[hidden]down- OrderBillingApiImpl
OrderInvoiceAccessImpl -[hidden]down- OrderServiceImpl
OrderBillingApi -[hidden]down- KitchenStockAllocator
OrderInvoiceAccess -[hidden]down- OrderItemStockFlags
KitchenStockAllocator -[hidden]down- DailyMenuLookupImpl
OrderItemStockFlags -[hidden]down- DailyMenuLookupImpl

' Gọi API của module khác (nét đứt xanh)
InvoiceServiceImpl .[#2563EB].> OrderBillingApi
OrderServiceImpl .[#2563EB].> OrderInvoiceAccess
OrderServiceImpl .[#2563EB].> KitchenStockAllocator
OrderServiceImpl .[#2563EB].> DailyMenuLookup
KitchenStockAllocatorImpl .[#2563EB].> DailyMenuLookup

' Cài đặt interface của chính module
OrderBillingApi <|.up. OrderBillingApiImpl
KitchenStockAllocator <|.up. KitchenStockAllocatorImpl
DailyMenuLookup <|.up. DailyMenuLookupImpl

' Đảo phụ thuộc: module trên cài interface do module dưới khai báo (nét đứt cam)
OrderInvoiceAccessImpl .[#EA580C].|> OrderInvoiceAccess
OrderItemStockFlagsImpl .[#EA580C].|> OrderItemStockFlags
QuotaUsageCounterImpl .[#EA580C].|> QuotaUsageCounter

legend bottom
  <color:#2563EB>- - ></color> gọi API của module khác      <color:#EA580C>- - ▷</color> đảo phụ thuộc: module trên cài interface do module dưới khai báo
  Mọi mũi tên giữa các module đều hướng xuống: finance → order → inventory → menu, không có vòng (ModularityTest kiểm mỗi lần build).
endlegend
@enduml
