@startuml
!include _style.iuml
skinparam conditionStyle diamond
skinparam conditionEndStyle diamond
title Activity: mở bàn và gọi món
|Phục vụ|
start
:Chọn bàn trống;
|Hệ thống|
if (Bàn đang dùng và không có khách?) then ([đúng])
  :Tạo phiên OPEN + đơn OPEN,\nbàn OCCUPIED;
else ([sai])
  :Trả 409 bàn đã có khách;
  stop
endif
|Phục vụ|
while (Khách gọi món?) is ([có])
  :Chọn món từ thực đơn hôm nay, số lượng, ghi chú;
  :Gửi đợt gọi món (requestKey);
  |Hệ thống|
  if (requestKey đã gửi?) then ([có])
    :Trả lại đợt cũ (replayed);
  else ([chưa])
    if (Món đang bán, không tạm dừng,\nđủ nguyên liệu?) then ([đúng])
      :Tạo đợt + dòng món PENDING,\nchụp giá bán;
      if (Vượt hạn mức suất?) then ([có])
        :Kèm cảnh báo vượt hạn mức;
      else ([không])
      endif
    else ([sai])
      :Báo lỗi 409, không tạo đợt;
    endif
  endif
  |Phục vụ|
endwhile ([không])
stop
@enduml
