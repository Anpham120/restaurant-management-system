# Copy to .env on the server, next to docker-compose.prod.yml, and fill in real values:
#   ~/bnn-rms/.env          production (branch main)
#   ~/bnn-rms-staging/.env  staging (branch develop)
GHCR_OWNER=anpham120
POSTGRES_PASSWORD=change-me
# At least 32 characters, random. Example: openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Same key as in SePay > Webhooks > API Key
SEPAY_API_KEY=change-me
# Public address printed in table QR codes, e.g. https://bnn.example.vn (staging: https://staging.bnn.example.vn)
APP_PUBLIC_BASE_URL=https://bnn.example.vn
# Host port of the web container. Staging on the same server: 8080
HTTP_PORT=80
# true only on staging or a demo server
APP_DEMO_ACCOUNTS_ENABLED=false
# Nightly database backup (backup service): hour in Vietnam time, and how many dumps to keep
BACKUP_HOUR=3
BACKUP_KEEP=7
