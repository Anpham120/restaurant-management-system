# Copy to ~/caddy/.env on the server, next to docker-compose.yml and the Caddyfile (doc 11).
# Both names need an A record pointing to the server before Caddy starts.
DOMAIN=khoibep.example.vn
STAGING_DOMAIN=staging.khoibep.example.vn
# HTTP_PORT in ~/khoibep-rms/.env (production) and ~/khoibep-rms-staging/.env (staging)
PRODUCTION_PORT=8081
STAGING_PORT=8080
