@startuml
!include _style.iuml
skinparam conditionStyle diamond
skinparam conditionEndStyle diamond
title Activity: bếp xử lý món và phục vụ
|Bếp|
start
:Xem hàng đợi (PENDING trước);
:Chọn nhận món, hoặc từ chối\nkèm lý do;
|Hệ thống|
if (Bếp từ chối?) then ([có])
  :Món REJECTED kèm lý do\n(không chiếm suất);
  stop
elseif (Còn suất và đủ nguyên liệu?) then ([không])
  :Món REJECTED\n(thiếu suất hoặc nguyên liệu);
  stop
else ([có])
  :Chiếm suất, giữ nguyên liệu\ntheo lô hết hạn sớm nhất (FEFO);
  :Món ACCEPTED;
endif
|Bếp|
:Bắt đầu nấu;
|Hệ thống|
:Tiêu hao phần đã giữ,\nghi sổ kho COOK một lần;
:Món COOKING;
|Bếp|
:Nấu xong;
|Hệ thống|
:Món READY;
|Phục vụ|
:Bưng món cho khách;
|Hệ thống|
:Món SERVED, ghi sự kiện\n(người, thời điểm);
stop
@enduml
