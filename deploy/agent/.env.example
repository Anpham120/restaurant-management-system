# Copy to ~/agent/.env on the application server and fill in (docs-core/11 section 11.10).
# Name of the monitoring server (deploy/ops): the agent pushes to https://<MONITOR_DOMAIN>/ingest/...
MONITOR_DOMAIN=monitor.khoibep.example.vn
# The push account of the monitoring server: INGEST_USER there, and the password whose hash is INGEST_PASSWORD_HASH there.
INGEST_USER=agent
INGEST_PASSWORD=change-me
# Same value as APP_METRICS_TOKEN in ~/khoibep-rms/.env and ~/khoibep-rms-staging/.env
APP_METRICS_TOKEN=change-me
# Shown on dashboards and alerts as server="..."
SERVER_NAME=app
