@startuml
!include ../_style.puml
hide circle
set separator none
skinparam linetype ortho
skinparam nodesep 85
skinparam ranksep 55
title ERD – Phân hệ 3: Quản lý đơn hàng

entity "dining_tables" as dining_tables {
  * id : bigint <<PK>>
  --
  * code : varchar(20) <<UK>>
  * capacity : int
  * status : varchar(20)
  ..
  CHECK status IN (AVAILABLE, OCCUPIED)
  CHECK capacity > 0
}

entity "table_sessions" as table_sessions {
  * id : bigint <<PK>>
  --
  * dining_table_id : bigint <<FK>>
  * opened_at : timestamptz
  closed_at : timestamptz
  * status : varchar(20)
  ..
  PARTIAL UK (dining_table_id) WHERE status = OPEN
  CHECK status IN (OPEN, CLOSED)
  TRIGGER: dining_table_id không đổi sau khi tạo
}

entity "orders" as orders {
  * id : bigint <<PK>>
  --
  * table_session_id : bigint <<FK, UK>>
  * status : varchar(20)
  ..
  CHECK status IN (OPEN, CLOSED, CANCELLED)
}

entity "order_batches" as order_batches {
  * id : bigint <<PK>>
  --
  * order_id : bigint <<FK>>
  * waiter_id : bigint <<FK>>
  * submitted_at : timestamptz
  * request_key : varchar(64) <<UK>>
}

entity "order_items" as order_items {
  * id : bigint <<PK>>
  --
  * order_batch_id : bigint <<FK>>
  * daily_menu_item_id : bigint <<FK>>
  * quantity : int
  * unit_price : decimal(12,2)
  * status : varchar(20)
  * has_stock_exception : boolean
  note : varchar(255)
  ..
  CHECK status IN (PENDING, ACCEPTED, IN_KITCHEN, COOKING, READY, CANCELLED, REJECTED)
  CHECK quantity > 0 AND unit_price >= 0
}

entity "order_item_events" as order_item_events {
  * id : bigint <<PK>>
  --
  * order_item_id : bigint <<FK>>
  * actor_id : bigint <<FK>>
  from_status : varchar(20)
  * to_status : varchar(20)
  reason : varchar(255)
  * kitchen_confirmed : boolean
  * created_at : timestamptz
  ..
  CHECK from_status, to_status IN (PENDING, ACCEPTED, IN_KITCHEN, COOKING, READY, CANCELLED, REJECTED)
}

entity "invoices" as invoices {
  * id : bigint <<PK>>
  --
  * order_id : bigint <<FK, UK>>
  * total : decimal(12,2)
  * status : varchar(20)
  ..
  CHECK status IN (DRAFT, PAYMENT_PENDING, PAID)
  CHECK total >= 0
}

entity "payment_requests" as payment_requests {
  * id : bigint <<PK>>
  --
  * invoice_id : bigint <<FK>>
  * waiter_id : bigint <<FK>>
  cashier_id : bigint <<FK>>
  * amount_due : decimal(12,2)
  cash_received : decimal(12,2)
  cash_counted : decimal(12,2)
  change_amount : decimal(12,2)
  * method : varchar(20)
  * status : varchar(30)
  payment_reference : varchar(64) <<UK>>
  cancel_reason : varchar(255)
  ..
  PARTIAL UK (invoice_id) WHERE status <> CANCELLED
  CHECK method IN (QR, CASH)
  CHECK status IN (REQUESTED, APPROVED, WAITING_TRANSFER, WAITING_CASH_HANDOVER, PAID, CANCELLED)
  CHECK amount_due >= 0
  CHECK cash_received, cash_counted, change_amount >= 0
  CHECK change_amount = GREATEST(cash_received - amount_due, 0)
  CHECK change_amount có khi và chỉ khi có cash_received
  CHECK payment_reference chỉ khi QR; bắt buộc khi QR ở WAITING_TRANSFER, PAID
  CHECK QR: không có cash_received, cash_counted, change_amount
  CHECK CASH đã PAID: bắt buộc cash_counted = cash_received >= amount_due
  CHECK CANCELLED: bắt buộc cancel_reason
}

entity "payments" as payments {
  * id : bigint <<PK>>
  --
  * payment_request_id : bigint <<FK, UK>>
  payment_webhook_event_id : bigint <<FK, UK>>
  * amount : decimal(12,2)
  * method : varchar(20)
  * paid_at : timestamptz
  * business_date : date
  ..
  FK (payment_webhook_event_id, payment_request_id) → payment_webhook_events (id, payment_request_id)
  CHECK method IN (QR, CASH)
  CHECK amount > 0
  CHECK payment_webhook_event_id bắt buộc khi QR, trống khi CASH
}

entity "payment_webhook_events" as payment_webhook_events {
  * id : bigint <<PK>>
  --
  payment_request_id : bigint <<FK>>
  * provider_transaction_code : varchar(64) <<UK>>
  payment_reference : varchar(64)
  * amount : decimal(12,2)
  * processing_result : varchar(20)
  * received_at : timestamptz
  raw_payload : text
  ..
  UK (id, payment_request_id)
  CHECK processing_result IN (PROCESSED, MISMATCH, AFTER_CANCEL)
  CHECK PROCESSED: bắt buộc payment_request_id
}

entity "employees" as employees #line.dashed {
  * id : bigint <<PK>>
  --
  * employee_code : varchar(20) <<UK>>
  * full_name : varchar(100)
}

entity "daily_menu_items" as daily_menu_items #line.dashed {
  * id : bigint <<PK>>
  --
  * daily_menu_id : bigint <<FK>>
  * quota_total : int
  * is_paused : boolean
}

entity "daily_menus" as daily_menus #line.dashed {
  * id : bigint <<PK>>
  --
  * business_date : date <<UK>>
  * status : varchar(20)
}

dining_tables ||--o{ table_sessions : hosts
table_sessions ||--o| orders : contains
orders ||--o{ order_batches : includes
order_batches ||--o{ order_items : contains
daily_menu_items ||--o{ order_items : selected_from
order_items ||--o{ order_item_events : logs
orders ||--o| invoices : billed_by
invoices ||--o{ payment_requests : receives
payment_requests ||--o| payments : completes
payment_requests |o--o{ payment_webhook_events : notified_by
employees ||--o{ order_batches : submits
employees ||--o{ payment_requests : requests
employees |o--o{ payment_requests : approves
employees ||--o{ order_item_events : performs
daily_menus ||--o{ daily_menu_items : includes
payment_webhook_events |o--o| payments : confirms
@enduml
