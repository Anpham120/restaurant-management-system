@startuml
!include ../_style.puml
hide circle
set separator none
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 55
title ERD – Phân hệ 5: Quản lý thu chi & đối soát cuối ngày

entity "operating_expenses" as operating_expenses {
  * id : bigint <<PK>>
  --
  * business_date : date
  * category : varchar(30)
  * description : varchar(255)
  * amount : decimal(12,2)
  * payment_method : varchar(20)
  * fund_source : varchar(20)
  stock_receipt_id : bigint <<FK>>
  * recorded_by_id : bigint <<FK>>
  * paid_at : timestamptz
  * created_at : timestamptz
  * status : varchar(20)
  void_reason : varchar(255)
  voided_by_id : bigint <<FK>>
  voided_at : timestamptz
}

entity "daily_cash_reconciliations" as daily_cash_reconciliations {
  * id : bigint <<PK>>
  --
  * business_date : date
  * version : int
  * status : varchar(20)
  * opening_cash : decimal(12,2)
  * cash_sales : decimal(12,2)
  * cash_expenses : decimal(12,2)
  * expected_cash : decimal(12,2)
  * actual_cash : decimal(12,2)
  * difference : decimal(12,2)
  reason : varchar(255)
  revision_reason : varchar(255)
  * reconciled_by_id : bigint <<FK>>
  * reconciled_at : timestamptz
  ..
  UK (business_date, version)
  UK (business_date) khi CURRENT
}

entity "employees" as employees {
  * id : bigint <<PK>>
  --
  * employee_code : varchar(20) <<UK>>
  * full_name : varchar(100)
  gender : varchar(10)
  date_of_birth : date
  * phone : varchar(15)
  email : varchar(100)
  address : varchar(255)
  * hire_date : date
  end_date : date
  * work_status : varchar(20)
  * department_id : bigint <<FK>>
}

entity "stock_receipts" as stock_receipts {
  * id : bigint <<PK>>
  --
  supplier_name : varchar(100)
  * status : varchar(20)
  note : varchar(255)
  * created_at : timestamptz
  confirmed_by_id : bigint <<FK>>
  confirmed_at : timestamptz
}

entity "daily_menu_items" as daily_menu_items {
  * id : bigint <<PK>>
  --
  * daily_menu_id : bigint <<FK>>
  * menu_item_id : bigint <<FK>>
  * recipe_id : bigint <<FK>>
  * quota_total : int
  * is_paused : boolean
  pause_reason : varchar(255)
  ..
  UK (daily_menu_id, menu_item_id)
}

entity "payments" as payments {
  * id : bigint <<PK>>
  --
  * payment_request_id : bigint <<FK>>
  provider_transaction_code : varchar(64) <<UK>>
  * amount : decimal(12,2)
  * method : varchar(20)
  * paid_at : timestamptz
  * business_date : date
}

entity "order_items" as order_items {
  * id : bigint <<PK>>
  --
  * order_batch_id : bigint <<FK>>
  * daily_menu_item_id : bigint <<FK>>
  * quantity : int
  * unit_price : decimal(12,2)
  * status : varchar(20)
  * has_stock_exception : boolean
  note : varchar(255)
}

employees ||--o{ operating_expenses : recorded_by
employees |o--o{ operating_expenses : voided_by
stock_receipts |o--o{ operating_expenses : paid_by
employees ||--o{ daily_cash_reconciliations : reconciled_by
daily_menu_items ||--o{ order_items : selected_from
daily_cash_reconciliations ..> payments : cash_sales
daily_cash_reconciliations ..> operating_expenses : cash_expenses
employees |o--o{ stock_receipts : confirmed_by

legend right
  * bắt buộc, PK khóa chính, FK khóa ngoại, UK duy nhất
  Bảng của phân hệ 1, 2, 3, 4 vẽ đủ cột để thấy liên kết; khóa ngoại trỏ ra ngoài sơ đồ này: xem ERD tổng thể.
  Mũi tên nét đứt: dữ liệu được tổng hợp theo ngày kinh doanh (chỉ đọc), không phải khóa ngoại.
  Tra cứu 5.4 và báo cáo 5.5 chỉ đọc bảng của phân hệ 2, 3, 4, không có bảng riêng.
endlegend
@enduml
