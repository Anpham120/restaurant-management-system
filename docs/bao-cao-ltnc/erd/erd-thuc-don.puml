@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam entity {
  BackgroundColor #EAF2FB
  BorderColor #1565C0
}
title ERD phân hệ Thực đơn
entity "menu_categories" as menu_categories {
  * id : bigint <<PK>>
  --
  * name : character varying(100)
  * sort_order : integer
  * is_active : boolean
}
entity "menu_items" as menu_items {
  * id : bigint <<PK>>
  --
  * menu_category_id : bigint <<FK>>
  * name : character varying(100)
  * price : numeric(12,2)
  image_url : character varying(255)
  * is_active : boolean
}
entity "recipes" as recipes {
  * id : bigint <<PK>>
  --
  * menu_item_id : bigint <<FK>>
  * is_current : boolean
}
entity "recipe_ingredients" as recipe_ingredients {
  * id : bigint <<PK>>
  --
  * recipe_id : bigint <<FK>>
  * kitchen_ingredient_type_id : bigint <<FK>>
  * quantity_per_serving : numeric(12,3)
}
entity "daily_menus" as daily_menus {
  * id : bigint <<PK>>
  --
  * business_date : date
  * status : character varying(20)
  published_at : timestamp with time zone
}
entity "daily_menu_items" as daily_menu_items {
  * id : bigint <<PK>>
  --
  * daily_menu_id : bigint <<FK>>
  * menu_item_id : bigint <<FK>>
  * recipe_id : bigint <<FK>>
  quota_total : integer
  * is_paused : boolean
  pause_reason : character varying(255)
  paused_by_id : bigint <<FK>>
  paused_at : timestamp with time zone
}
entity "employees" as employees #F3F6FA {
  * id : bigint <<PK>>
}
entity "kitchen_ingredient_types" as kitchen_ingredient_types #F3F6FA {
  * id : bigint <<PK>>
}
daily_menu_items }o--|| daily_menus : daily_menu_id
daily_menu_items }o--|| menu_items : menu_item_id
daily_menu_items }o--o| employees : paused_by_id
daily_menu_items }o--|| recipes : recipe_id
daily_menu_items }o--|| recipes : menu_item_id,recipe_id
menu_items }o--|| menu_categories : menu_category_id
recipe_ingredients }o--|| kitchen_ingredient_types : kitchen_ingredient_type_id
recipe_ingredients }o--|| recipes : recipe_id
recipes }o--|| menu_items : menu_item_id
@enduml
