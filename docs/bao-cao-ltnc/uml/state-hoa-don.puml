@startuml
!include _style.iuml
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #1F2937
}
hide empty description
title Biểu đồ trạng thái: hóa đơn (invoices.status)
state "Chưa thanh toán" as CHUA {
  state PAYMENT_PENDING
  state DRAFT
  PAYMENT_PENDING --> DRAFT : Mở lại hóa đơn\nhoặc khách gọi thêm món
  DRAFT --> PAYMENT_PENDING : Chốt lại hóa đơn\n/ tính lại tổng tiền
}
[*] --> PAYMENT_PENDING : Thu ngân chốt hóa đơn\n[mọi món đã kết thúc,\ncó món SERVED, tổng > 0]
PAYMENT_PENDING --> PAID : Thu tiền mặt đủ\nhoặc webhook SePay khớp\n/ đóng đơn, trả bàn
CHUA --> WAIVED : Quản lý miễn thu\nhoặc khách bỏ về [0 đồng]
CHUA --> UNCOLLECTED : Khách bỏ về\n[còn tiền phải thu]
PAID --> [*]
WAIVED --> [*]
UNCOLLECTED --> [*]
legend bottom
  Chuyển trạng thái đi từ viền "Chưa thanh toán" áp dụng cho cả DRAFT và PAYMENT_PENDING.
endlegend
@enduml
