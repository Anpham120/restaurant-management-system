@startuml
!include _style.iuml
skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #000000
  LifeLineBorderColor #000000
  LifeLineBackgroundColor #FFFFFF
  ActorBorderColor #000000
  ActorBackgroundColor #FFFFFF
}
skinparam maxMessageSize 130
skinparam ParticipantPadding 4
skinparam defaultFontSize 14
skinparam ArrowColor #000000
hide footbox
autonumber 13
title Biểu đồ tuần tự (2/2): SePay báo tiền về, hệ thống ghi tiền và đóng hóa đơn
actor "Khách" as K
participant "SePay" as SP <<hệ thống>>
participant "SepayWebhook\nController" as WC
participant "SepayWebhook\nService" as WS
participant "QrTransfer\nProcessor" as QP
participant "Invoice\nSettlement" as IS
database "PostgreSQL" as DB

K -> SP : quét QR, chuyển khoản
SP -> WC : POST /api/webhooks/sepay (Authorization: Apikey)
activate WC
WC -> WS : receiveTransferWebhook(header, body)
activate WS
WS -> WS : kiểm khóa API, đúng tài khoản nhận, tách mã tham chiếu
WS -> QP : recordVerifiedTransfer(mã GD, tham chiếu, số tiền, ...)
activate QP
QP -> DB : khóa theo mã giao dịch (advisory lock)
alt mã giao dịch đã ghi
  QP --> WS : kết quả cũ (không thu lần hai)
else lần đầu
  QP -> DB : khóa hóa đơn và PaymentRequest
  QP -> DB : lưu payment_webhook_events
  opt PROCESSED: đúng mã, đúng số tiền, còn chờ thu
    QP -> DB : lưu Payment QR
    QP -> IS : settlePaidInvoice(invoice, actorId)
    activate IS
    IS -> DB : hóa đơn PAID; qua OrderBillingApi đóng đơn, đóng phiên, trả bàn
    deactivate IS
  end
  QP --> WS : PROCESSED / MISMATCH / AFTER_CANCEL
end
deactivate QP
WS --> WC : WebhookResult
deactivate WS
WC --> SP : 200 OK
deactivate WC

@enduml
