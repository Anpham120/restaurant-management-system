@startuml
!include ../_style.puml
title Sơ đồ hoạt động – Quản lý bàn và phiên phục vụ

|Waiter|
start
:Mở màn hình "Sơ đồ bàn";
|Hệ thống|
:Hiển thị các bàn và trạng thái;
|Waiter|
:Chọn bàn hoặc phiên và thao tác;
|Hệ thống|
if (Mở bàn?) then (có)
  if (Bàn AVAILABLE?) then (có)
    :Tạo phiên OPEN, đơn OPEN\nvà hóa đơn DRAFT;
    :Bàn chuyển OCCUPIED;
  else (không)
    :Từ chối mở bàn;
  endif
elseif (Chuyển bàn?) then (có)
  if (Bàn đích AVAILABLE và chưa có\nyêu cầu thanh toán đang hoạt động?) then (có)
    :Gán phiên sang bàn mới,\ngiữ nguyên đơn và lịch sử món;
    :Bàn cũ AVAILABLE, bàn mới OCCUPIED,\nđồng bộ POS;
  else (không)
    :Từ chối chuyển bàn;
  endif
else (Kết thúc phiên)
  if (Hóa đơn PAID?) then (có)
    :Đơn CLOSED;
    :Phiên CLOSED, bàn AVAILABLE;
  elseif (Không có khoản phải thanh toán,\nmọi món đã hủy / từ chối hợp lệ?) then (có)
    :Đơn CANCELLED;
    :Phiên CLOSED, bàn AVAILABLE;
  else (không)
    :Từ chối kết thúc phiên;
  endif
endif
|Waiter|
:Nhận kết quả thao tác;
stop
@enduml
