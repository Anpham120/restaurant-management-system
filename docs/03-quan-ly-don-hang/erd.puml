@startuml
!include ../_style.puml
hide circle
set separator none
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 55
title ERD – Phân hệ 3: Quản lý đơn hàng

entity "dining_tables" as dining_tables {
  * id : bigint <<PK>>
  --
  * code : varchar(20) <<UK>>
  * capacity : int
  * status : varchar(20)
}

entity "table_sessions" as table_sessions {
  * id : bigint <<PK>>
  --
  * dining_table_id : bigint <<FK>>
  * opened_at : timestamptz
  closed_at : timestamptz
  * status : varchar(20)
}

entity "orders" as orders {
  * id : bigint <<PK>>
  --
  * table_session_id : bigint <<FK>>
  * status : varchar(20)
}

entity "order_batches" as order_batches {
  * id : bigint <<PK>>
  --
  * order_id : bigint <<FK>>
  * waiter_id : bigint <<FK>>
  * submitted_at : timestamptz
  * request_key : varchar(64) <<UK>>
}

entity "order_items" as order_items {
  * id : bigint <<PK>>
  --
  * order_batch_id : bigint <<FK>>
  * daily_menu_item_id : bigint <<FK>>
  * quantity : int
  * unit_price : decimal(12,2)
  * status : varchar(20)
  * has_stock_exception : boolean
  note : varchar(255)
}

entity "order_item_events" as order_item_events {
  * id : bigint <<PK>>
  --
  * order_item_id : bigint <<FK>>
  * actor_id : bigint <<FK>>
  from_status : varchar(20)
  * to_status : varchar(20)
  reason : varchar(255)
  * kitchen_confirmed : boolean
  * created_at : timestamptz
}

entity "invoices" as invoices {
  * id : bigint <<PK>>
  --
  * order_id : bigint <<FK>>
  * total : decimal(12,2)
  * status : varchar(20)
}

entity "payment_requests" as payment_requests {
  * id : bigint <<PK>>
  --
  * invoice_id : bigint <<FK>>
  * waiter_id : bigint <<FK>>
  cashier_id : bigint <<FK>>
  * amount_due : decimal(12,2)
  cash_received : decimal(12,2)
  cash_counted : decimal(12,2)
  change_amount : decimal(12,2)
  * method : varchar(20)
  * status : varchar(30)
  payment_reference : varchar(64)
  cancel_reason : varchar(255)
}

entity "payments" as payments {
  * id : bigint <<PK>>
  --
  * payment_request_id : bigint <<FK>>
  provider_transaction_code : varchar(64) <<UK>>
  * amount : decimal(12,2)
  * method : varchar(20)
  * paid_at : timestamptz
  * business_date : date
}

entity "payment_webhook_events" as payment_webhook_events {
  * id : bigint <<PK>>
  --
  payment_request_id : bigint <<FK>>
  * provider_transaction_code : varchar(64) <<UK>>
  payment_reference : varchar(64)
  * amount : decimal(12,2)
  * processing_result : varchar(20)
  * received_at : timestamptz
  raw_payload : text
}

entity "employees" as employees {
  * id : bigint <<PK>>
  --
  * employee_code : varchar(20) <<UK>>
  * full_name : varchar(100)
  gender : varchar(10)
  date_of_birth : date
  * phone : varchar(15)
  email : varchar(100)
  address : varchar(255)
  * hire_date : date
  end_date : date
  * work_status : varchar(20)
  * department_id : bigint <<FK>>
}

entity "daily_menu_items" as daily_menu_items {
  * id : bigint <<PK>>
  --
  * daily_menu_id : bigint <<FK>>
  * menu_item_id : bigint <<FK>>
  * recipe_id : bigint <<FK>>
  * quota_total : int
  * is_paused : boolean
  pause_reason : varchar(255)
  ..
  UK (daily_menu_id, menu_item_id)
}

dining_tables ||--o{ table_sessions : hosts
table_sessions ||--o{ orders : contains
orders ||--o{ order_batches : includes
order_batches ||--o{ order_items : contains
daily_menu_items ||--o{ order_items : selected_from
order_items ||--o{ order_item_events : logs
orders ||--o{ invoices : billed_by
invoices ||--o{ payment_requests : receives
payment_requests ||--o| payments : completes
payment_requests |o--o{ payment_webhook_events : notified_by
employees ||--o{ order_batches : submits
employees ||--o{ payment_requests : requests
employees |o--o{ payment_requests : approves
employees ||--o{ order_item_events : performs

legend right
  * bắt buộc, PK khóa chính, FK khóa ngoại, UK duy nhất
  employees (phân hệ 1) và daily_menu_items (phân hệ 2) vẽ đủ cột để thấy liên kết.
  Khóa ngoại trỏ ra ngoài sơ đồ này: xem ERD tổng thể.
endlegend
@enduml
