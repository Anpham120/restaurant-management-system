@startuml
!include _style.iuml
skinparam style strictuml
hide empty members
title Biểu đồ lớp các tầng trong module order (gọi món, bếp)
skinparam linetype ortho

package "controller" {
  class OrderController <<RestController>> {
    - orderService : OrderService
    - currentUser : CurrentUser
    + submitOrderBatch(orderId, request) : ApiResponse<SubmitBatchResponse>
  }
  class OrderItemController <<RestController>> {
    + acceptOrderItem(itemId) : ApiResponse<AcceptItemResponse>
    + startCookingOrderItem(itemId) : ApiResponse<OrderItemResponse>
  }
}
package "service" {
  interface OrderService <<interface>> {
    + submitOrderBatch(orderId, actorId, request) : SubmitBatchResponse
    + markOrderItemServed(itemId, actorId) : OrderItemResponse
  }
  interface KitchenService <<interface>> {
    + acceptOrderItem(itemId, actorId) : AcceptItemResponse
    + startCookingOrderItem(itemId, actorId) : OrderItemResponse
  }
  class OrderServiceImpl
  class KitchenServiceImpl
  class OrderItemStatusChanger {
    + recordItemCreated(item, actorId)
    + changeItemStatus(item, allowedFrom, next, actorId, reason)
  }
}
package "repository" {
  interface CustomerOrderRepository <<interface>> {
    + findByIdForUpdate(id)
  }
  interface OrderBatchRepository <<interface>> {
    + findByRequestKey(requestKey)
  }
  interface OrderItemRepository <<interface>> {
    + findByIdForUpdate(id)
  }
}
package "entity" {
  class CustomerOrder {
    - id : Long
    - status : OrderStatus
  }
  class OrderBatch {
    - id : Long
    - requestKey : String
  }
  class OrderItem {
    - id : Long
    - quantity : int
    - itemNameSnapshot : String
    - unitPrice : BigDecimal
  }
  enum OrderItemStatus <<enumeration>> {
    PENDING
    ACCEPTED
    COOKING
    READY
    SERVED
    REJECTED
    CANCELLED
  }
}
package "API của module khác" {
  interface DailyMenuLookup <<interface>> <<menu>>
  interface KitchenStockAllocator <<interface>> <<inventory>>
}

OrderController --> OrderService
OrderItemController --> KitchenService
OrderService <|.. OrderServiceImpl
KitchenService <|.. KitchenServiceImpl
OrderServiceImpl --> OrderItemStatusChanger
KitchenServiceImpl --> OrderItemStatusChanger
OrderServiceImpl ..> CustomerOrderRepository
OrderServiceImpl ..> OrderBatchRepository
OrderServiceImpl ..> OrderItemRepository
KitchenServiceImpl ..> OrderItemRepository
OrderServiceImpl ..> DailyMenuLookup
KitchenServiceImpl ..> KitchenStockAllocator
CustomerOrderRepository ..> CustomerOrder
OrderBatchRepository ..> OrderBatch
OrderItemRepository ..> OrderItem
OrderBatch "1..*" --> "1" CustomerOrder : order
OrderItem "1..*" --> "1" OrderBatch : batch
OrderItem --> "1" OrderItemStatus : status
note bottom of OrderItemRepository
  findByIdForUpdate: @Lock(PESSIMISTIC_WRITE)
  sinh SELECT ... FOR UPDATE, khóa dòng món
  trong giao dịch trước khi đổi trạng thái.
end note
note right of OrderBatch
  requestKey UNIQUE: gửi lặp cùng khóa
  trả lại đợt cũ (chống gửi trùng).
end note
@enduml
