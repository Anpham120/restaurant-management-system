@startuml
!include _style.iuml
skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #000000
  LifeLineBorderColor #000000
  LifeLineBackgroundColor #FFFFFF
  ActorBorderColor #000000
  ActorBackgroundColor #FFFFFF
}
skinparam maxMessageSize 150
skinparam ParticipantPadding 4
skinparam defaultFontSize 14
skinparam ArrowColor #000000
hide footbox
autonumber
title Biểu đồ tuần tự (1/2): thu ngân tạo mã QR, màn hình chờ và nhận kết quả
actor "Thu\nngân" as TN
participant "InvoicePage\n(React)" as FE
participant "Invoice\nController" as IC
participant "Payment\nController" as PC
participant "Payment\nServiceImpl" as PS
participant "QrPayment\nStrategy" as QS
database "PostgreSQL" as DB

TN -> FE : bấm "Tạo mã QR"
activate FE
FE -> PC : POST /api/invoices/{id}/payments {method: QR}
activate PC
PC -> PS : startPayment(invoiceId, actorId, request)
activate PS
PS -> QS : startPayment(...) theo strategies[QR]
activate QS
QS -> DB : khóa hóa đơn (FOR UPDATE)
QS -> DB : lưu PaymentRequest WAITING_TRANSFER, mã RC<hóa đơn>Q<n>
QS --> PS : PaymentResponse
deactivate QS
PS --> PC : PaymentResponse
deactivate PS
PC --> FE : 201 (mã tham chiếu, ảnh QR)
deactivate PC
FE --> TN : hiện ảnh QR, "Đang chờ tiền về"
deactivate FE

loop mỗi 3 giây khi còn QR đang chờ
  FE -> IC : GET /api/orders/{id}/invoice
  activate IC
  IC --> FE : hóa đơn PAYMENT_PENDING
  deactivate IC
end

== Sau khi SePay báo tiền về và hệ thống ghi tiền (hình 2/2) ==
autonumber 28
FE -> IC : GET /api/orders/{id}/invoice
activate IC
IC --> FE : hóa đơn PAID
deactivate IC
FE --> TN : "Đã thu ... bằng chuyển khoản. Bàn đã được trả."
@enduml
