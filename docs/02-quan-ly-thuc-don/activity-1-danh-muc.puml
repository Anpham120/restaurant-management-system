@startuml
!include ../_style.puml
title Sơ đồ hoạt động – Quản lý danh mục món ăn

|Manager|
start
:Mở màn hình "Danh mục món ăn";
|Hệ thống|
:Hiển thị danh sách món theo loại;
|Manager|
if (Chọn thao tác) then (Thêm / sửa món)
  :Chọn "Thêm món" hoặc\nchọn món cần sửa;
  if (Cần loại món mới?) then (có)
    :Nhập tên loại món\nvà thứ tự hiển thị;
    |Hệ thống|
    :Lưu loại món;
    |Manager|
  else (không)
  endif
  repeat
    :Nhập tên món, chọn loại món, giá bán,\nhình ảnh, trạng thái kinh doanh;
    |Hệ thống|
    :Kiểm tra dữ liệu bắt buộc\nvà giá bán hợp lệ;
  repeat while (Dữ liệu không hợp lệ?) is (có, báo lỗi) not (không)
  :Lưu món ăn;
else (Bật hoặc tắt kinh doanh)
  |Manager|
  :Chọn món và trạng thái\nkinh doanh mới;
  |Hệ thống|
  :Cập nhật trạng thái kinh doanh;
endif
:Thông báo kết quả;
stop
@enduml
