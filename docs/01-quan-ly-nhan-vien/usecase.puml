@startuml
!include ../_style.puml
left to right direction
skinparam nodesep 40
skinparam ranksep 80
title Sơ đồ use case – Phân hệ 1: Quản lý nhân viên

actor "Manager\n(Quản lý)" as Manager

rectangle "Restaurant Core – Phân hệ 1: Quản lý nhân viên" {
  package "1. Hồ sơ nhân viên" #FFFFFF;line.dashed {
    usecase "UC01\nThêm nhân viên" as UC01
    usecase "UC02\nSửa hồ sơ nhân viên" as UC02
    usecase "UC03\nTìm kiếm nhân viên" as UC03
    usecase "UC04\nCập nhật trạng thái\nlàm việc" as UC04
  }

  package "2. Tài khoản và phân quyền" #FFFFFF;line.dashed {
    usecase "UC05\nCấp tài khoản" as UC05
    usecase "UC06\nKhóa hoặc mở khóa\ntài khoản" as UC06
    usecase "UC07\nĐặt lại mật khẩu" as UC07
    usecase "UC08\nGán vai trò\ncho tài khoản" as UC08
  }

  package "3. Phân ca" #FFFFFF;line.dashed {
    usecase "UC09\nCấu hình ca\nlàm việc" as UC09
    usecase "UC10\nPhân lịch làm việc\ntheo tuần" as UC10
    usecase "UC11\nXem lịch làm việc\ntheo tuần" as UC11
    usecase "UC12\nSửa hoặc hủy\nphân ca" as UC12
  }

  package "4. Chấm công" #FFFFFF;line.dashed {
    usecase "UC13\nXem danh sách ca\ncần chấm công" as UC13
    usecase "UC14\nXác nhận có mặt\n(hàng loạt)" as UC14
    usecase "UC15\nXác nhận vắng mặt" as UC15
    usecase "UC16\nXác nhận làm\nkhác giờ" as UC16
  }

  package "5. Bảng công" #FFFFFF;line.dashed {
    usecase "UC17\nXem bảng công\ntổng hợp" as UC17
    usecase "UC18\nĐiều chỉnh công" as UC18
    usecase "UC19\nXuất bảng công\nra Excel" as UC19
  }
}

Manager -- UC01
Manager -- UC02
Manager -- UC03
Manager -- UC04
Manager -- UC05
Manager -- UC06
Manager -- UC07
Manager -- UC08
Manager -- UC09
Manager -- UC10
Manager -- UC11
Manager -- UC12
Manager -- UC14
Manager -- UC15
Manager -- UC16
Manager -- UC17

UC14 ..> UC13 : <<include>>
UC15 ..> UC13 : <<include>>
UC16 ..> UC13 : <<include>>
UC17 <.. UC18 : <<extend>>
UC17 <.. UC19 : <<extend>>
@enduml
