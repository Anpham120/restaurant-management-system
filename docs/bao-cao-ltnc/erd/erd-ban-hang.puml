@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam entity {
  BackgroundColor #EAF2FB
  BorderColor #1565C0
}
title ERD phân hệ Bán hàng và thanh toán
entity "dining_tables" as dining_tables {
  * id : bigint <<PK>>
  --
  * code : character varying(20)
  * capacity : integer
  * status : character varying(20)
  * is_active : boolean
}
entity "table_sessions" as table_sessions {
  * id : bigint <<PK>>
  --
  * dining_table_id : bigint <<FK>>
  * opened_at : timestamp with time zone
  closed_at : timestamp with time zone
  * status : character varying(20)
  * opened_by_id : bigint <<FK>>
  closed_by_id : bigint <<FK>>
}
entity "orders" as orders {
  * id : bigint <<PK>>
  --
  * table_session_id : bigint <<FK>>
  * status : character varying(20)
}
entity "order_batches" as order_batches {
  * id : bigint <<PK>>
  --
  * order_id : bigint <<FK>>
  * waiter_id : bigint <<FK>>
  * submitted_at : timestamp with time zone
  * request_key : character varying(64)
  request_hash : character(64)
}
entity "order_items" as order_items {
  * id : bigint <<PK>>
  --
  * order_batch_id : bigint <<FK>>
  * daily_menu_item_id : bigint <<FK>>
  * quantity : integer
  * item_name_snapshot : character varying(100)
  * unit_price : numeric(12,2)
  * status : character varying(20)
  * has_stock_exception : boolean
  note : character varying(255)
}
entity "order_item_events" as order_item_events {
  * id : bigint <<PK>>
  --
  * order_item_id : bigint <<FK>>
  * actor_id : bigint <<FK>>
  from_status : character varying(20)
  * to_status : character varying(20)
  reason : character varying(255)
}
entity "invoices" as invoices {
  * id : bigint <<PK>>
  --
  * order_id : bigint <<FK>>
  * total : numeric(12,2)
  * status : character varying(20)
  * created_by_id : bigint <<FK>>
  uncollected_reason : character varying(255)
  uncollected_by_id : bigint <<FK>>
  uncollected_at : timestamp with time zone
  waived_reason : character varying(255)
  waived_by_id : bigint <<FK>>
  waived_at : timestamp with time zone
}
entity "invoice_items" as invoice_items {
  * id : bigint <<PK>>
  --
  * invoice_id : bigint <<FK>>
  * order_item_id : bigint <<FK>>
  * item_name : character varying(100)
  * quantity : integer
  * unit_price : numeric(12,2)
  line_total : numeric(12,2)
}
entity "payment_requests" as payment_requests {
  * id : bigint <<PK>>
  --
  * invoice_id : bigint <<FK>>
  * cashier_id : bigint <<FK>>
  * amount_due : numeric(12,2)
  cash_received : numeric(12,2)
  change_amount : numeric(12,2)
  * method : character varying(20)
  * status : character varying(30)
  payment_reference : character varying(64)
  cancel_reason : character varying(255)
  cancelled_at : timestamp with time zone
  cancelled_by_id : bigint <<FK>>
}
entity "payment_webhook_events" as payment_webhook_events {
  * id : bigint <<PK>>
  --
  payment_request_id : bigint <<FK>>
  * provider_transaction_code : character varying(64)
  * payment_reference : character varying(64)
  * amount : numeric(12,2)
  * processing_result : character varying(20)
  * received_at : timestamp with time zone
  * raw_payload : text
  resolution_status : character varying(20)
  resolved_by_id : bigint <<FK>>
  resolved_at : timestamp with time zone
  resolution_note : character varying(255)
}
entity "payments" as payments {
  * id : bigint <<PK>>
  --
  * invoice_id : bigint <<FK>>
  * payment_request_id : bigint <<FK>>
  payment_webhook_event_id : bigint <<FK>>
  * amount : numeric(12,2)
  * method : character varying(20) <<FK>>
  * paid_at : timestamp with time zone
  * business_date : date
}
entity "daily_menu_items" as daily_menu_items #F3F6FA {
  * id : bigint <<PK>>
}
entity "employees" as employees #F3F6FA {
  * id : bigint <<PK>>
}
invoice_items }o--|| invoices : invoice_id
invoice_items |o--|| order_items : order_item_id
invoices }o--|| employees : created_by_id
invoices |o--|| orders : order_id
invoices }o--o| employees : uncollected_by_id
invoices }o--o| employees : waived_by_id
order_item_events }o--|| employees : actor_id
order_item_events }o--|| order_items : order_item_id
order_items }o--|| daily_menu_items : daily_menu_item_id
order_items }o--|| order_batches : order_batch_id
orders |o--|| table_sessions : table_session_id
payment_requests }o--o| employees : cancelled_by_id
payment_requests }o--|| employees : cashier_id
payment_requests }o--|| invoices : invoice_id
payment_webhook_events }o--o| payment_requests : payment_request_id
payment_webhook_events }o--o| employees : resolved_by_id
payments }o--|| payment_requests : invoice_id,method,payment_request_id
payments }o--o| payment_webhook_events : payment_request_id,payment_webhook_event_id
payments |o--|| invoices : invoice_id
payments |o--|| payment_requests : payment_request_id
payments |o--o| payment_webhook_events : payment_webhook_event_id
table_sessions }o--o| employees : closed_by_id
table_sessions }o--|| dining_tables : dining_table_id
table_sessions }o--|| employees : opened_by_id
order_batches }o--|| orders : order_id
order_batches }o--|| employees : waiter_id
@enduml
