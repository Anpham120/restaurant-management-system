@startuml
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam entity {
  BackgroundColor #EAF2FB
  BorderColor #1565C0
}
title ERD phân hệ Kho và bếp
entity "ingredients" as ingredients {
  * id : bigint <<PK>>
  --
  * name : character varying(100)
  * base_unit : character varying(20)
  * min_quantity : numeric(12,3)
  * is_expiry_tracked : boolean
  * is_active : boolean
}
entity "kitchen_ingredient_types" as kitchen_ingredient_types {
  * id : bigint <<PK>>
  --
  * raw_ingredient_id : bigint <<FK>>
  * name : character varying(100)
  * handling_type : character varying(12)
  shelf_life_hours : integer
  * minimum_quantity : numeric(12,3)
  * is_active : boolean
}
entity "stock_receipts" as stock_receipts {
  * id : bigint <<PK>>
  --
  supplier_name : character varying(100)
  * status : character varying(20)
  note : character varying(255)
  * created_by_id : bigint <<FK>>
  received_at : timestamp with time zone
  confirmed_by_id : bigint <<FK>>
  confirmed_at : timestamp with time zone
  * request_key : character varying(64)
  * request_hash : character(64)
}
entity "stock_receipt_items" as stock_receipt_items {
  * id : bigint <<PK>>
  --
  * stock_receipt_id : bigint <<FK>>
  * ingredient_id : bigint <<FK>>
  * input_quantity : numeric(12,3)
  * input_unit : character varying(20)
  * conversion_factor : numeric(12,3)
  * unit_price_per_input_unit : numeric(12,2)
  lot_code : character varying(50)
  expiry_date : date
}
entity "inventory_batches" as inventory_batches {
  * id : bigint <<PK>>
  --
  * stock_receipt_item_id : bigint <<FK>>
  * received_at : timestamp with time zone
  * quantity_on_hand : numeric(12,3)
  * is_usable : boolean
  unusable_reason : character varying(255)
  unusable_marked_by_id : bigint <<FK>>
  unusable_marked_at : timestamp with time zone
}
entity "stock_issues" as stock_issues {
  * id : bigint <<PK>>
  --
  * issued_by_id : bigint <<FK>>
  received_by_id : bigint <<FK>>
  * status : character varying(20)
  issued_at : timestamp with time zone
  received_at : timestamp with time zone
  note : character varying(255)
  cancel_reason : character varying(255)
  cancelled_at : timestamp with time zone
  cancelled_by_id : bigint <<FK>>
  * request_key : character varying(64)
  * request_hash : character(64)
}
entity "stock_issue_items" as stock_issue_items {
  * id : bigint <<PK>>
  --
  * stock_issue_id : bigint <<FK>>
  * inventory_batch_id : bigint <<FK>>
  * quantity : numeric(12,3)
  * fulfillment_mode : character varying(12)
  * wip_remaining_quantity : numeric(12,3)
}
entity "kitchen_preparations" as kitchen_preparations {
  * id : bigint <<PK>>
  --
  * stock_issue_item_id : bigint <<FK>>
  * input_quantity : numeric(12,3)
  * status : character varying(20)
  loss_reason : character varying(255)
  * prepared_by_id : bigint <<FK>>
  prepared_at : timestamp with time zone
  * request_key : character varying(64)
  request_hash : character(64)
}
entity "kitchen_preparation_outputs" as kitchen_preparation_outputs {
  * id : bigint <<PK>>
  --
  * kitchen_preparation_id : bigint <<FK>>
  * kitchen_ingredient_type_id : bigint <<FK>>
  * output_quantity : numeric(12,3)
  usable_until : timestamp with time zone
}
entity "kitchen_batches" as kitchen_batches {
  * id : bigint <<PK>>
  --
  * kitchen_ingredient_type_id : bigint <<FK>>
  preparation_output_id : bigint <<FK>>
  direct_issue_item_id : bigint <<FK>>
  usable_until : timestamp with time zone
  * quantity_on_hand : numeric(12,3)
  * reserved_quantity : numeric(12,3)
  * is_usable : boolean
  unusable_reason : character varying(255)
  unusable_marked_by_id : bigint <<FK>>
  unusable_marked_at : timestamp with time zone
}
entity "stock_reservations" as stock_reservations {
  * id : bigint <<PK>>
  --
  * order_item_id : bigint <<FK>>
  * kitchen_batch_id : bigint <<FK>>
  * quantity : numeric(12,3)
  * status : character varying(20)
  release_reason : character varying(30)
  closed_at : timestamp with time zone
}
entity "stock_returns" as stock_returns {
  * id : bigint <<PK>>
  --
  * status : character varying(20)
  * requested_by_id : bigint <<FK>>
  confirmed_by_id : bigint <<FK>>
  * reason : character varying(255)
  confirmed_at : timestamp with time zone
  * request_key : character varying(64)
  request_hash : character(64)
}
entity "stock_return_items" as stock_return_items {
  * id : bigint <<PK>>
  --
  * stock_return_id : bigint <<FK>>
  * source_issue_item_id : bigint <<FK>>
  direct_kitchen_batch_id : bigint <<FK>>
  * quantity : numeric(12,3)
}
entity "stock_adjustments" as stock_adjustments {
  * id : bigint <<PK>>
  --
  * status : character varying(20)
  * adjustment_type : character varying(20)
  * reason : character varying(255)
  * created_by_id : bigint <<FK>>
  confirmed_by_id : bigint <<FK>>
  confirmed_at : timestamp with time zone
  * request_key : character varying(64)
  request_hash : character(64)
}
entity "stock_adjustment_items" as stock_adjustment_items {
  * id : bigint <<PK>>
  --
  * stock_adjustment_id : bigint <<FK>>
  raw_batch_id : bigint <<FK>>
  wip_issue_item_id : bigint <<FK>>
  kitchen_batch_id : bigint <<FK>>
  * quantity_delta : numeric(12,3)
  note : character varying(255)
}
entity "stock_counts" as stock_counts {
  * id : bigint <<PK>>
  --
  * status : character varying(20)
  note : character varying(255)
  * created_by_id : bigint <<FK>>
  confirmed_by_id : bigint <<FK>>
  confirmed_at : timestamp with time zone
  * request_key : character varying(64)
  * request_hash : character(64)
}
entity "stock_count_items" as stock_count_items {
  * id : bigint <<PK>>
  --
  * stock_count_id : bigint <<FK>>
  raw_batch_id : bigint <<FK>>
  wip_issue_item_id : bigint <<FK>>
  kitchen_batch_id : bigint <<FK>>
  * book_quantity : numeric(12,3)
  * actual_quantity : numeric(12,3)
  reason : character varying(255)
}
entity "stock_movements" as stock_movements {
  * id : bigint <<PK>>
  --
  * movement_type : character varying(30)
  raw_batch_id : bigint <<FK>>
  wip_issue_item_id : bigint <<FK>>
  kitchen_batch_id : bigint <<FK>>
  * quantity_delta : numeric(12,3)
  ref_issue_item_id : bigint <<FK>>
  preparation_id : bigint <<FK>>
  order_item_id : bigint <<FK>>
  stock_count_item_id : bigint <<FK>>
  stock_return_item_id : bigint <<FK>>
  stock_adjustment_item_id : bigint <<FK>>
  reason : character varying(255)
  * event_key : character varying(64)
}
entity "employees" as employees #F3F6FA {
  * id : bigint <<PK>>
}
entity "order_items" as order_items #F3F6FA {
  * id : bigint <<PK>>
}
inventory_batches |o--|| stock_receipt_items : stock_receipt_item_id
inventory_batches }o--o| employees : unusable_marked_by_id
kitchen_batches }o--o| kitchen_preparation_outputs : kitchen_ingredient_type_id,preparation_output_id
kitchen_batches |o--o| stock_issue_items : direct_issue_item_id
kitchen_batches }o--|| kitchen_ingredient_types : kitchen_ingredient_type_id
kitchen_batches |o--o| kitchen_preparation_outputs : preparation_output_id
kitchen_batches }o--o| employees : unusable_marked_by_id
kitchen_ingredient_types }o--|| ingredients : raw_ingredient_id
kitchen_preparation_outputs }o--|| kitchen_ingredient_types : kitchen_ingredient_type_id
kitchen_preparation_outputs }o--|| kitchen_preparations : kitchen_preparation_id
stock_adjustment_items }o--o| kitchen_batches : kitchen_batch_id
stock_adjustment_items }o--o| inventory_batches : raw_batch_id
stock_adjustment_items }o--|| stock_adjustments : stock_adjustment_id
stock_adjustment_items }o--o| stock_issue_items : wip_issue_item_id
stock_count_items }o--o| kitchen_batches : kitchen_batch_id
stock_count_items }o--o| inventory_batches : raw_batch_id
stock_count_items }o--|| stock_counts : stock_count_id
stock_count_items }o--o| stock_issue_items : wip_issue_item_id
stock_counts }o--o| employees : confirmed_by_id
stock_counts }o--|| employees : created_by_id
stock_issue_items }o--|| inventory_batches : inventory_batch_id
stock_issue_items }o--|| stock_issues : stock_issue_id
stock_issues }o--o| employees : cancelled_by_id
stock_issues }o--|| employees : issued_by_id
stock_issues }o--o| employees : received_by_id
stock_movements }o--o| kitchen_batches : kitchen_batch_id
stock_movements }o--o| order_items : order_item_id
stock_movements }o--o| kitchen_preparations : preparation_id
stock_movements }o--o| inventory_batches : raw_batch_id
stock_movements }o--o| stock_issue_items : ref_issue_item_id
stock_movements }o--o| stock_adjustment_items : stock_adjustment_item_id
stock_movements }o--o| stock_count_items : stock_count_item_id
stock_movements }o--o| stock_return_items : stock_return_item_id
stock_movements }o--o| stock_issue_items : wip_issue_item_id
stock_receipt_items }o--|| ingredients : ingredient_id
stock_receipt_items }o--|| stock_receipts : stock_receipt_id
stock_receipts }o--o| employees : confirmed_by_id
stock_receipts }o--|| employees : created_by_id
stock_reservations }o--|| kitchen_batches : kitchen_batch_id
stock_reservations }o--|| order_items : order_item_id
stock_return_items }o--o| kitchen_batches : direct_kitchen_batch_id,source_issue_item_id
stock_return_items }o--o| kitchen_batches : direct_kitchen_batch_id
stock_return_items }o--|| stock_issue_items : source_issue_item_id
stock_return_items }o--|| stock_returns : stock_return_id
kitchen_preparations }o--|| employees : prepared_by_id
kitchen_preparations }o--|| stock_issue_items : stock_issue_item_id
stock_returns }o--o| employees : confirmed_by_id
stock_returns }o--|| employees : requested_by_id
stock_adjustments }o--o| employees : confirmed_by_id
stock_adjustments }o--|| employees : created_by_id
@enduml
