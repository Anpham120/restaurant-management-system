# Sao chép thành .env (đã có trong .gitignore) rồi điền giá trị. KHÔNG commit .env.

# --- PostgreSQL (docker compose) ---
DB_NAME=restaurant_core
DB_PORT=5433
# Tài khoản quản trị: chỉ dùng để khởi tạo database và chạy Flyway, không dùng cho request của app.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=doi-mat-khau-quan-tri
# Tài khoản app (thành viên role rc_app, tạo tự động lần đầu).
DB_APP_USER=rms_api
DB_APP_PASSWORD=doi-mat-khau-app
# Tài khoản webhook SePay (role rc_webhook) — tạo tự động lần đầu khi có đủ hai biến.
# Database đã khởi tạo trước khi đặt biến: tạo tay theo docs/backend/DEVELOPMENT_GUIDE.md (mục SePay).
DB_WEBHOOK_USER=rms_sepay
DB_WEBHOOK_PASSWORD=doi-mat-khau-webhook

# --- Spring Boot ---
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8081
# Chạy app ngoài Docker (./mvnw spring-boot:run) thì đặt thêm:
# DB_URL=jdbc:postgresql://localhost:5433/restaurant_core
# FLYWAY_USER=postgres
# FLYWAY_PASSWORD=<giống DB_ADMIN_PASSWORD>
# Database MỚI dựng từ docs/ bằng compose: đặt true để Flyway ghi baseline v1 ở lần chạy đầu.
# Database đã có dữ liệu / production: để false và baseline có chủ đích (docs/backend/DEVELOPMENT_GUIDE.md).
FLYWAY_BASELINE_ON_MIGRATE=true
# Tối thiểu 32 ký tự ngẫu nhiên, ví dụ: openssl rand -base64 48
JWT_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- SePay ---
# Khóa API đặt ở mục Webhook của SePay (kiểu xác thực "API Key"): SePay gửi "Authorization: Apikey <khóa>".
SEPAY_API_KEY=
# Tài khoản nhận tiền cho ảnh QR (bank theo https://qr.sepay.vn/banks.json), ví dụ Vietcombank.
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
