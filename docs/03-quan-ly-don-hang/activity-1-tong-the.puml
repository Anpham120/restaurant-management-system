@startuml
!include ../_style.puml
title Sơ đồ hoạt động – Luồng vận hành tổng thể của đơn hàng

|Waiter|
start
:Khách đến nhà hàng;
:Mở bàn (mở phiên phục vụ);
repeat
  :Chọn món trên điện thoại;
  :Gửi đơn đến POS;
  |Order Coordinator (POS)|
  :Duyệt hoặc từ chối từng dòng món;
  :Chuyển các món ACCEPTED xuống bếp;
  |Bếp|
  :Nhận phiếu, bắt đầu chế biến, báo POS;
  |Order Coordinator (POS)|
  :Ghi nhận COOKING, kho tiêu hao đúng một lần;
  |Bếp|
  :Hoàn thành món, báo POS;
  |Order Coordinator (POS)|
  :Cập nhật món sẵn sàng (READY);
  :Gọi phục vụ qua bộ đàm;
  |Waiter|
  :Mang món ra bàn;
repeat while (Khách gọi thêm món?) is (có) not (không)
:Khách yêu cầu thanh toán;
:Gửi yêu cầu thanh toán đến thu ngân;
|Cashier|
:Duyệt yêu cầu thanh toán;
|Waiter|
if (Phương thức thanh toán?) then (QR)
  :Hiển thị QR, khách chuyển khoản;
  |Hệ thống|
  :Kiểm tra webhook và đối chiếu giao dịch;
  if (Chưa có xác nhận hợp lệ?) then (có)
    :Giữ hóa đơn chờ, không đóng bàn;
    stop
  else (không)
  endif
else (Tiền mặt)
  |Waiter|
  :Thu tiền mặt tại bàn\nvà mang về quầy;
  |Cashier|
  :Kiểm đếm, xử lý tiền thừa\nrồi xác nhận đã nhận tiền mặt;
endif
|Hệ thống|
:Hóa đơn PAID, đơn CLOSED;
:Kết thúc phiên, bàn AVAILABLE;
stop
@enduml
