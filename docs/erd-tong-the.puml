@startuml
!include _style.puml
hide circle
set separator none
skinparam nodesep 40
skinparam ranksep 50
title ERD tổng thể – Restaurant Core (phân hệ 1 đến 5)

entity "departments" as departments {
  * id : bigint <<PK>>
  --
  * department_name : varchar(50) <<UK>>
}

entity "employees" as employees {
  * id : bigint <<PK>>
  --
  * employee_code : varchar(20) <<UK>>
  * full_name : varchar(100)
  gender : varchar(10)
  date_of_birth : date
  * phone : varchar(15)
  email : varchar(100)
  address : varchar(255)
  * hire_date : date
  end_date : date
  * work_status : varchar(20)
  * department_id : bigint <<FK>>
}

entity "accounts" as accounts {
  * id : bigint <<PK>>
  --
  * employee_id : bigint <<FK, UK>>
  * username : varchar(50) <<UK>>
  * password_hash : varchar(255)
  * must_change_password : boolean
  * account_status : varchar(20)
}

entity "roles" as roles {
  * id : bigint <<PK>>
  --
  * role_code : varchar(30) <<UK>>
  * role_name : varchar(50)
}

entity "permissions" as permissions {
  * id : bigint <<PK>>
  --
  * permission_code : varchar(50) <<UK>>
  description : varchar(255)
}

entity "account_roles" as account_roles {
  * id : bigint <<PK>>
  --
  * account_id : bigint <<FK>>
  * role_id : bigint <<FK>>
  ..
  UK (account_id, role_id)
}

entity "role_permissions" as role_permissions {
  * id : bigint <<PK>>
  --
  * role_id : bigint <<FK>>
  * permission_id : bigint <<FK>>
  ..
  UK (role_id, permission_id)
}

entity "shifts" as shifts {
  * id : bigint <<PK>>
  --
  * shift_name : varchar(50) <<UK>>
  * start_time : time
  * end_time : time
  * break_minutes : integer
  * is_active : boolean
  ..
  CHECK end_time khác start_time
  CHECK 0 ≤ break_minutes ≤ thời lượng ca
}

entity "shift_assignments" as shift_assignments {
  * id : bigint <<PK>>
  --
  * employee_id : bigint <<FK>>
  * shift_id : bigint <<FK>>
  * work_date : date
  * scheduled_start_at : timestamptz
  * scheduled_end_at : timestamptz
  * scheduled_break_minutes : integer
  * status : varchar(20)
  note : varchar(255)
  cancel_reason : varchar(255)
  cancelled_by_id : bigint <<FK>>
  cancelled_at : timestamptz
  ..
  CHECK scheduled_end_at > scheduled_start_at
  CHECK 0 ≤ scheduled_break_minutes ≤ thời lượng
  EXCLUDE (employee_id =, khoảng thời gian &&) khi SCHEDULED
}

entity "attendances" as attendances {
  * id : bigint <<PK>>
  --
  * shift_assignment_id : bigint <<FK, UK>>
  * attendance_status : varchar(20)
  actual_start_at : timestamptz
  actual_end_at : timestamptz
  * worked_minutes : integer
  note : varchar(255)
  * confirmed_by_id : bigint <<FK>>
  * confirmed_at : timestamptz
}

entity "attendance_adjustments" as attendance_adjustments {
  * id : bigint <<PK>>
  --
  * attendance_id : bigint <<FK>>
  * old_status : varchar(20)
  * new_status : varchar(20)
  old_start_at : timestamptz
  new_start_at : timestamptz
  old_end_at : timestamptz
  new_end_at : timestamptz
  * old_worked_minutes : integer
  * new_worked_minutes : integer
  * reason : varchar(255)
  * adjusted_by_id : bigint <<FK>>
  * adjusted_at : timestamptz
}

entity "menu_categories" as menu_categories {
  * id : bigint <<PK>>
  --
  * name : varchar(100)
  * sort_order : int
  * is_active : boolean
}

entity "menu_items" as menu_items {
  * id : bigint <<PK>>
  --
  * menu_category_id : bigint <<FK>>
  * name : varchar(100)
  * price : decimal(12,2)
  image_url : varchar(255)
  * is_active : boolean
}

entity "recipes" as recipes {
  * id : bigint <<PK>>
  --
  * menu_item_id : bigint <<FK>>
  * version : int
  * is_current : boolean
  ..
  UK (menu_item_id, version)
}

entity "recipe_ingredients" as recipe_ingredients {
  * id : bigint <<PK>>
  --
  * recipe_id : bigint <<FK>>
  * ingredient_id : bigint <<FK>>
  * quantity_per_serving : decimal(12,3)
}

entity "daily_menus" as daily_menus {
  * id : bigint <<PK>>
  --
  * business_date : date <<UK>>
  * status : varchar(20)
  published_at : timestamptz
}

entity "daily_menu_items" as daily_menu_items {
  * id : bigint <<PK>>
  --
  * daily_menu_id : bigint <<FK>>
  * menu_item_id : bigint <<FK>>
  * recipe_id : bigint <<FK>>
  * quota_total : int
  * is_paused : boolean
  pause_reason : varchar(255)
  ..
  UK (daily_menu_id, menu_item_id)
}

entity "dining_tables" as dining_tables {
  * id : bigint <<PK>>
  --
  * code : varchar(20) <<UK>>
  * capacity : int
  * status : varchar(20)
}

entity "table_sessions" as table_sessions {
  * id : bigint <<PK>>
  --
  * dining_table_id : bigint <<FK>>
  * opened_at : timestamptz
  closed_at : timestamptz
  * status : varchar(20)
}

entity "orders" as orders {
  * id : bigint <<PK>>
  --
  * table_session_id : bigint <<FK>>
  * status : varchar(20)
}

entity "order_batches" as order_batches {
  * id : bigint <<PK>>
  --
  * order_id : bigint <<FK>>
  * waiter_id : bigint <<FK>>
  * submitted_at : timestamptz
  * request_key : varchar(64) <<UK>>
}

entity "order_items" as order_items {
  * id : bigint <<PK>>
  --
  * order_batch_id : bigint <<FK>>
  * daily_menu_item_id : bigint <<FK>>
  * quantity : int
  * unit_price : decimal(12,2)
  * status : varchar(20)
  * has_stock_exception : boolean
  note : varchar(255)
}

entity "order_item_events" as order_item_events {
  * id : bigint <<PK>>
  --
  * order_item_id : bigint <<FK>>
  * actor_id : bigint <<FK>>
  from_status : varchar(20)
  * to_status : varchar(20)
  reason : varchar(255)
  * kitchen_confirmed : boolean
  * created_at : timestamptz
}

entity "invoices" as invoices {
  * id : bigint <<PK>>
  --
  * order_id : bigint <<FK>>
  * total : decimal(12,2)
  * status : varchar(20)
}

entity "payment_requests" as payment_requests {
  * id : bigint <<PK>>
  --
  * invoice_id : bigint <<FK>>
  * waiter_id : bigint <<FK>>
  cashier_id : bigint <<FK>>
  * amount_due : decimal(12,2)
  cash_received : decimal(12,2)
  cash_counted : decimal(12,2)
  change_amount : decimal(12,2)
  * method : varchar(20)
  * status : varchar(30)
  payment_reference : varchar(64)
  cancel_reason : varchar(255)
}

entity "payments" as payments {
  * id : bigint <<PK>>
  --
  * payment_request_id : bigint <<FK>>
  provider_transaction_code : varchar(64) <<UK>>
  * amount : decimal(12,2)
  * method : varchar(20)
  * paid_at : timestamptz
  * business_date : date
}

entity "payment_webhook_events" as payment_webhook_events {
  * id : bigint <<PK>>
  --
  payment_request_id : bigint <<FK>>
  * provider_transaction_code : varchar(64) <<UK>>
  payment_reference : varchar(64)
  * amount : decimal(12,2)
  * processing_result : varchar(20)
  * received_at : timestamptz
  raw_payload : text
}

entity "ingredients" as ingredients {
  * id : bigint <<PK>>
  --
  * name : varchar(100) <<UK>>
  * base_unit : varchar(20)
  * min_quantity : decimal(12,3)
  * is_expiry_tracked : boolean
  * is_active : boolean
}

entity "stock_receipts" as stock_receipts {
  * id : bigint <<PK>>
  --
  supplier_name : varchar(100)
  * status : varchar(20)
  note : varchar(255)
  * created_at : timestamptz
  confirmed_by_id : bigint <<FK>>
  confirmed_at : timestamptz
}

entity "stock_receipt_items" as stock_receipt_items {
  * id : bigint <<PK>>
  --
  * stock_receipt_id : bigint <<FK>>
  * ingredient_id : bigint <<FK>>
  * input_quantity : decimal(12,3)
  * input_unit : varchar(20)
  * conversion_factor : decimal(12,3)
  * quantity : decimal(12,3)
  * unit_price : decimal(12,2)
  lot_code : varchar(50)
  expiry_date : date
}

entity "inventory_batches" as inventory_batches {
  * id : bigint <<PK>>
  --
  * ingredient_id : bigint <<FK>>
  * stock_receipt_item_id : bigint <<FK, UK>>
  lot_code : varchar(50)
  expiry_date : date
  * received_at : timestamptz
  * quantity_on_hand : decimal(12,3)
  * reserved_quantity : decimal(12,3)
  * is_usable : boolean
  unusable_reason : varchar(255)
  unusable_marked_by_id : bigint <<FK>>
  unusable_marked_at : timestamptz
  ..
  CHECK quantity_on_hand >= 0
}

entity "stock_movements" as stock_movements {
  * id : bigint <<PK>>
  --
  * inventory_batch_id : bigint <<FK>>
  * movement_type : varchar(20)
  * quantity_delta : decimal(12,3)
  * balance_after : decimal(12,3)
  order_item_id : bigint <<FK>>
  stock_count_item_id : bigint <<FK, UK>>
  * created_at : timestamptz
  ..
  UK (inventory_batch_id) khi RECEIPT
  UK (order_item_id, inventory_batch_id)
}

entity "stock_reservations" as stock_reservations {
  * id : bigint <<PK>>
  --
  * order_item_id : bigint <<FK>>
  * inventory_batch_id : bigint <<FK>>
  * quantity : decimal(12,3)
  * status : varchar(20)
  release_reason : varchar(30)
  * created_at : timestamptz
  closed_at : timestamptz
  ..
  UK (order_item_id, inventory_batch_id) khi ACTIVE
}

entity "stock_counts" as stock_counts {
  * id : bigint <<PK>>
  --
  * status : varchar(20)
  note : varchar(255)
  * created_at : timestamptz
  confirmed_by_id : bigint <<FK>>
  confirmed_at : timestamptz
}

entity "stock_count_items" as stock_count_items {
  * id : bigint <<PK>>
  --
  * stock_count_id : bigint <<FK>>
  * inventory_batch_id : bigint <<FK>>
  * book_quantity : decimal(12,3)
  * actual_quantity : decimal(12,3)
  * difference : decimal(12,3)
  reason : varchar(255)
  ..
  UK (stock_count_id, inventory_batch_id)
}

entity "operating_expenses" as operating_expenses {
  * id : bigint <<PK>>
  --
  * business_date : date
  * category : varchar(30)
  * description : varchar(255)
  * amount : decimal(12,2)
  * payment_method : varchar(20)
  * fund_source : varchar(20)
  stock_receipt_id : bigint <<FK>>
  * recorded_by_id : bigint <<FK>>
  * paid_at : timestamptz
  * created_at : timestamptz
  * status : varchar(20)
  void_reason : varchar(255)
  voided_by_id : bigint <<FK>>
  voided_at : timestamptz
}

entity "daily_cash_reconciliations" as daily_cash_reconciliations {
  * id : bigint <<PK>>
  --
  * business_date : date
  * version : int
  * status : varchar(20)
  * opening_cash : decimal(12,2)
  * cash_sales : decimal(12,2)
  * cash_expenses : decimal(12,2)
  * expected_cash : decimal(12,2)
  * actual_cash : decimal(12,2)
  * difference : decimal(12,2)
  reason : varchar(255)
  revision_reason : varchar(255)
  * reconciled_by_id : bigint <<FK>>
  * reconciled_at : timestamptz
  ..
  UK (business_date, version)
  UK (business_date) khi CURRENT
}

departments ||--o{ employees : has
employees ||--o| accounts : owns
accounts ||--o{ account_roles : has
roles ||--o{ account_roles : assigned_in
roles ||--o{ role_permissions : grants
permissions ||--o{ role_permissions : granted_in
employees ||--o{ shift_assignments : works
employees |o--o{ shift_assignments : cancelled_by
shifts ||--o{ shift_assignments : schedules
shift_assignments ||--o| attendances : confirmed_as
attendances ||--o{ attendance_adjustments : logs
employees ||--o{ attendances : confirmed_by
employees ||--o{ attendance_adjustments : adjusted_by
menu_categories ||--o{ menu_items : contains
menu_items ||--o{ recipes : has
recipes ||--o{ recipe_ingredients : contains
ingredients ||--o{ recipe_ingredients : used_in
daily_menus ||--o{ daily_menu_items : includes
menu_items ||--o{ daily_menu_items : appears_in
recipes ||--o{ daily_menu_items : applied_to
daily_menu_items ||--o{ order_items : selected_from
dining_tables ||--o{ table_sessions : hosts
table_sessions ||--o{ orders : contains
orders ||--o{ order_batches : includes
order_batches ||--o{ order_items : contains
order_items ||--o{ order_item_events : logs
orders ||--o{ invoices : billed_by
invoices ||--o{ payment_requests : receives
payment_requests ||--o| payments : completes
payment_requests |o--o{ payment_webhook_events : notified_by
employees ||--o{ order_batches : submits
employees ||--o{ payment_requests : requests
employees |o--o{ payment_requests : approves
employees ||--o{ order_item_events : performs
employees |o--o{ stock_receipts : confirmed_by
employees |o--o{ stock_counts : confirmed_by
employees |o--o{ inventory_batches : marked_unusable_by
ingredients ||--o{ stock_receipt_items : received_as
ingredients ||--o{ inventory_batches : stored_in
stock_receipts ||--o{ stock_receipt_items : contains
stock_receipt_items ||--o| inventory_batches : creates
inventory_batches ||--o{ stock_movements : affected_by
inventory_batches ||--o{ stock_reservations : reserved_from
order_items ||--o{ stock_reservations : reserves
order_items |o--o{ stock_movements : consumed_by
stock_counts ||--o{ stock_count_items : contains
inventory_batches ||--o{ stock_count_items : counted_in
stock_count_items |o--o| stock_movements : adjusted_by
employees ||--o{ operating_expenses : recorded_by
employees |o--o{ operating_expenses : voided_by
stock_receipts |o--o{ operating_expenses : paid_by
employees ||--o{ daily_cash_reconciliations : reconciled_by
daily_cash_reconciliations ..> payments : cash_sales
daily_cash_reconciliations ..> operating_expenses : cash_expenses

legend right
  * bắt buộc, PK khóa chính, FK khóa ngoại, UK duy nhất
  Mọi bảng của hệ thống và mọi khóa ngoại; định nghĩa gốc từng bảng nằm ở README phân hệ sở hữu.
  Mũi tên nét đứt: dữ liệu được tổng hợp theo ngày kinh doanh (chỉ đọc), không phải khóa ngoại.
endlegend
@enduml
