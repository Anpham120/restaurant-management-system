# Copy to .env on the server, next to docker-compose.prod.yml, and fill in real values:
#   ~/khoibep-rms/.env          production (branch main)
#   ~/khoibep-rms-staging/.env  staging (branch develop)
GHCR_OWNER=anpham120
POSTGRES_PASSWORD=change-me
# At least 32 characters, random. Example: openssl rand -base64 48
APP_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Same key as in SePay > Webhooks > API Key
SEPAY_API_KEY=change-me
# Public address printed in table QR codes, e.g. https://khoibep.example.vn (staging: https://staging.khoibep.example.vn)
APP_PUBLIC_BASE_URL=https://khoibep.example.vn
# Port of the web container on 127.0.0.1, where Caddy sends the requests: production 8081, staging 8080
HTTP_PORT=8081
# true only on staging or a demo server
APP_DEMO_ACCOUNTS_ENABLED=false
# Password of the demo accounts: set your own on any server reachable from the Internet
APP_DEMO_ACCOUNTS_PASSWORD=change-me
# BR-48, production only: at least 12 characters, creates the "admin" account of the empty database.
# Remove this line after signing in for the first time.
APP_INITIAL_ADMIN_PASSWORD=
# Nightly database backup (backup service): hour in Vietnam time, and how many dumps to keep
BACKUP_HOUR=3
BACKUP_KEEP=7
# NFR-12: token the monitoring agent (deploy/agent) sends to read /actuator/prometheus; empty keeps it shut.
# The same value in both environments and in ~/agent/.env. Example: openssl rand -hex 32
APP_METRICS_TOKEN=
