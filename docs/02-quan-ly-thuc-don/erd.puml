@startuml
!include ../_style.puml
hide circle
set separator none
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 55
title ERD – Phân hệ 2: Quản lý thực đơn

entity "daily_menus" as daily_menus {
  * id : bigint <<PK>>
  --
  * business_date : date <<UK>>
  * status : varchar(20)
  published_at : timestamptz
  ..
  CHECK status IN (DRAFT, PUBLISHED, CLOSED)
}

entity "menu_categories" as menu_categories {
  * id : bigint <<PK>>
  --
  * name : varchar(100)
  * sort_order : int
  * is_active : boolean
}

entity "menu_items" as menu_items {
  * id : bigint <<PK>>
  --
  * menu_category_id : bigint <<FK>>
  * name : varchar(100)
  * price : decimal(12,2)
  image_url : varchar(255)
  * is_active : boolean
  ..
  CHECK price >= 0
}

entity "recipes" as recipes {
  * id : bigint <<PK>>
  --
  * menu_item_id : bigint <<FK>>
  * version : int
  * is_current : boolean
  ..
  UK (menu_item_id, version)
  UK (id, menu_item_id)
  PARTIAL UK (menu_item_id) WHERE is_current
  CHECK version >= 1
}

entity "recipe_ingredients" as recipe_ingredients {
  * id : bigint <<PK>>
  --
  * recipe_id : bigint <<FK>>
  * ingredient_id : bigint <<FK>>
  * quantity_per_serving : decimal(12,3)
  ..
  UK (recipe_id, ingredient_id)
  CHECK quantity_per_serving > 0
}

entity "daily_menu_items" as daily_menu_items {
  * id : bigint <<PK>>
  --
  * daily_menu_id : bigint <<FK>>
  * menu_item_id : bigint <<FK>>
  * recipe_id : bigint <<FK>>
  * quota_total : int
  * is_paused : boolean
  pause_reason : varchar(255)
  ..
  UK (daily_menu_id, menu_item_id)
  FK (recipe_id, menu_item_id) → recipes (id, menu_item_id)
  CHECK quota_total >= 0
}

entity "ingredients" as ingredients #line.dashed {
  * id : bigint <<PK>>
  --
  * name : varchar(100) <<UK>>
  * base_unit : varchar(20)
}

entity "inventory_batches" as inventory_batches #line.dashed {
  * id : bigint <<PK>>
  --
  * ingredient_id : bigint <<FK>>
  expiry_date : date
  * quantity_on_hand : decimal(12,3)
  * reserved_quantity : decimal(12,3)
  * is_usable : boolean
}

entity "order_items" as order_items #line.dashed {
  * id : bigint <<PK>>
  --
  * daily_menu_item_id : bigint <<FK>>
  * quantity : int
  * status : varchar(20)
}

menu_categories ||--o{ menu_items : contains
menu_items ||--o{ recipes : has
recipes ||--o{ recipe_ingredients : contains
ingredients ||--o{ recipe_ingredients : used_in
daily_menus ||--o{ daily_menu_items : includes
menu_items ||--o{ daily_menu_items : appears_in
recipes ||--o{ daily_menu_items : applied_to
daily_menu_items ||--o{ order_items : selected_from
ingredients ||--o{ inventory_batches : stored_in
@enduml
